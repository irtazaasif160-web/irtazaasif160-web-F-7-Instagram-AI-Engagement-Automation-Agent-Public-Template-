      "id": "df24673a-d8b4-4c3d-a99f-c8036a5252c7",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst execution = input.execution || {};\nconst workflow = input.workflow || {};\nconst error = execution.error || input.error || {};\n\nconst statusCode =\n  error.httpCode ||\n  error.statusCode ||\n  error.status ||\n  error.response?.statusCode ||\n  null;\n\nlet category = 'UNEXPECTED_ERROR';\n\nif (statusCode === 401 || statusCode === 403) {\n  category = 'AUTH_ERROR';\n} else if (statusCode === 429) {\n  category = 'RATE_LIMIT';\n} else if (statusCode >= 500) {\n  category = 'SERVER_ERROR';\n} else if (statusCode >= 400) {\n  category = 'REQUEST_ERROR';\n} else if (\n  String(error.message || '').toLowerCase().includes('timeout')\n) {\n  category = 'TIMEOUT';\n}\n\nreturn [{\n  json: {\n    workflow_name: workflow.name || 'Unknown',\n    workflow_id: workflow.id || null,\n\n    execution_id: execution.id || null,\n    execution_url: execution.url || null,\n\n    failed_node: execution.lastNodeExecuted || 'Unknown',\n    node_type: error.node?.type || null,\n\n    error_message: error.message || 'Unknown error',\n    error_type: error.name || null,\n    error_category: category,\n    status_code: statusCode,\n\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
